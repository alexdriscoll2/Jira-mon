{
   "name": "chrome-vue-extension",
   "version": "1.0",
   "manifest_version": 3,
   "action": {},
   "permissions": [],
   "host_permissions": [
       "https://*.atlassian.net/jira/*"
   ],
   "background": {
       "service_worker": "background/background.js"
   },
   "content_scripts": [
       {
       "matches": ["https://*.atlassian.net/jira/*"],
       "js": ["main.js"]
       }
   ]
}